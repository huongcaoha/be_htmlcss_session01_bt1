[Unit]
Description=PTIT DevOps Lab API Backend (FastAPI)
After=network.target postgresql.service

[Service]
# Sinh viên tự xác định và điền đầy đủ các thông số cấu hình dưới đây:
User=nchuong
WorkingDirectory=/root/hackathon/backend-app
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
# Cấu hình tự động khởi động lại (restart) khi gặp lỗi:
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


